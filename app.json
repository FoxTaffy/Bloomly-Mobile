{
  "expo": {
    "name": "Bloomly",
    "slug": "bloomly",
    "scheme": "bloomly",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16192F",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.bloomly.mobile",
      "associatedDomains": [
        "applinks:bloomly.fun"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16192F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "app.bloomly.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bloomly.fun",
              "pathPrefix": "/post"
            },
            {
              "scheme": "https",
              "host": "bloomly.fun",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "bloomly.fun",
              "pathPrefix": "/groups"
            },
            {
              "scheme": "https",
              "host": "bloomly.fun",
              "pathPrefix": "/events"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "expo-image",
      "expo-video",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Bloomly обращается к вашей галерее, чтобы вы могли выбрать фото и видео для публикации в посте.",
          "cameraPermission": "Bloomly использует камеру, чтобы вы могли сделать фото для публикации в посте.",
          "microphonePermission": "Bloomly использует микрофон для записи голосовых сообщений в чате."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Bloomly использует микрофон для записи голосовых сообщений в чате.",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4C67CF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#16192F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 288,
          "resizeMode": "contain"
        }
      ],
      "expo-localization",
      "@sentry/react-native/expo"
    ]
  }
}
