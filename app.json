{
  "expo": {
    "name": "Bloomly",
    "slug": "bloomly",
    "scheme": "bloomly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#16192F",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.bloomly.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16192F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "app.bloomly.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "Bloomly использует микрофон для записи голосовых сообщений в чате."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4C67CF"
        }
      ]
    ]
  }
}
